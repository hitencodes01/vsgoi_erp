{
  "name": "vsgoi-erp-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "db:studio": "prisma studio",
    "db:fresh": "prisma migrate reset --force",
    "db:bootstrap": "node --env-file=.env prisma/bootstrap.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "6.9.16",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
